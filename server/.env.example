PORT=5000
NODE_ENV=development
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret

# Cloudflare R2 S3-compatible API credentials. Keep these server-side only.
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-api-token-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-api-token-secret-access-key>
R2_BUCKET=<bucket-name>
# Optional. If omitted, the server derives this from R2_ACCOUNT_ID.
R2_S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://<public-bucket-id>.r2.dev
